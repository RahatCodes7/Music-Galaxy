# Copy this file to .env and fill in your own values.
# NEVER commit the real .env to GitHub.

API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token_from_botfather
LOGGER_ID=-100your_log_group_id
OWNER_ID=your_telegram_user_id
STRING_SESSION=your_pyrogram_user_session_string

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB (REQUIRED) - define MONGO_DB_URI only ONCE in this file.
# A duplicate key silently overrides the earlier one (last value wins).
#
# Local server  -> mongodb://127.0.0.1:27017
# Local + data  -> mongodb://127.0.0.1:27017/musicgalaxy
# Docker        -> mongodb://mongo:27017        (use the compose service name)
# Atlas         -> mongodb+srv://user:password@cluster.mongodb.net/musicgalaxy
#
# The database used by the bot is taken from the URI path, otherwise
# "MusicGalaxy". Override it with MONGO_DB_NAME if you prefer.
# Test the whole thing without starting the bot:  python3 dbcheck.py
# ─────────────────────────────────────────────────────────────────────────────
MONGO_DB_URI=mongodb://127.0.0.1:27017/musicgalaxy

# Optional MongoDB tuning
# MONGO_DB_NAME=musicgalaxy
# MONGO_TIMEOUT_MS=8000
# MONGO_DIRECT_CONNECTION=false
#  ^ set true when the local server is a single-node replica set
#    (error "ReplicaSetNoPrimary") or when you prefer a direct connection.

YUKI_API_URL=https://dltapi.cc.cd
YUKI_API_KEY=dl_live_IMbe7IFdA-9pgZd1IgEKnFRBvEOwEC00Om1RSzUJStw
# Aliases (both work) - new naming
DLT_API_URL=https://dltapi.cc.cd
DLT_API_KEY=dl_live_IMbe7IFdA-9pgZd1IgEKnFRBvEOwEC00Om1RSzUJStw
DOWNLOAD_API_URL=https://dltapi.cc.cd
DOWNLOAD_API_KEY=dl_live_IMbe7IFdA-9pgZd1IgEKnFRBvEOwEC00Om1RSzUJStw

# Repository the bot pulls runtime updates from
UPSTREAM_REPO=https://github.com/RahatCodes7/Music-Galaxy.git
UPSTREAM_BRANCH=main
# Runtime self update, keep it off for container deployments
AUTO_UPDATE=false

SUPPORT_CHAT=https://t.me/your_group
SUPPORT_CHANNEL=https://t.me/your_channel
START_IMG_URL=https://files.catbox.moe/n83s9g.jpg
